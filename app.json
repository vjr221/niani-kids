{
  "expo": {
    "name": "Niani Kids",
    "slug": "niani-kids",
    "owner": "vjr221s-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "nianikids",
    "icon": "./assets/a_clean_graphic_png_logo_on_a_transparent_backgrou.png",
    "splash": {
      "image": "./assets/a_clean_graphic_png_logo_on_a_transparent_backgrou.png",
      "imageWidth": 220,
      "resizeMode": "contain",
      "backgroundColor": "#FFF7D6"
    },
    "android": {
      "package": "sn.nianikids.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/a_clean_graphic_png_logo_on_a_transparent_backgrou.png",
        "backgroundColor": "#FFF7D6"
      }
    },
    "ios": {
      "bundleIdentifier": "sn.nianikids.app"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
